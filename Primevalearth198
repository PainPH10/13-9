local function isTargetAliveAndValid(plr)
	if not plr or not plr.Parent or plr == player then return false end
	local char = plr.Character
	if not char or not char.Parent then return false end
	
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	
	if not hrp or not hum then return false end
	if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then return false end
	
	return true
end

RunService.RenderStepped:Connect(function()
	if combatConfig.Enabled and combatConfig.TargetPlayer then
		if isTargetAliveAndValid(combatConfig.TargetPlayer) then
			pcall(function()
				local targetHrp = combatConfig.TargetPlayer.Character:FindFirstChild("HumanoidRootPart")
				local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if targetHrp and myHrp then
					teleportToTarget(myHrp, targetHrp, combatConfig.TargetPlayer, combatConfig.Distance, combatConfig.Height, combatConfig.Mode)
				end
			end)
		end
	end

	if killConfig.Enabled then
		pcall(function()
			local myChar = player.Character
			local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
			if not myHrp then return end

			if not isTargetAliveAndValid(killConfig.CurrentTarget) then
				killConfig.CurrentTarget = nil
				
				local playerDistances = {}
				for _, plr in ipairs(Players:GetPlayers()) do
					if isTargetAliveAndValid(plr) then
						local targetHrp = plr.Character:FindFirstChild("HumanoidRootPart")
						local dist = (myHrp.Position - targetHrp.Position).Magnitude
						table.insert(playerDistances, {Player = plr, Distance = dist})
					end
				end

				table.sort(playerDistances, function(a, b) return a.Distance < b.Distance end)

				if #playerDistances > 0 then
					local targetIdx = killConfig.TargetIndex
					if targetIdx > #playerDistances then
						targetIdx = 1
					end
					killConfig.CurrentTarget = playerDistances[targetIdx].Player
				end
			end

			if isTargetAliveAndValid(killConfig.CurrentTarget) then
				local targetHrp = killConfig.CurrentTarget.Character:FindFirstChild("HumanoidRootPart")
				if targetHrp then
					teleportToTarget(myHrp, targetHrp, killConfig.CurrentTarget, killConfig.Distance, killConfig.Height, combatConfig.Mode)
				end
			end
		end)
	end
end)

RunService.RenderStepped:Connect(function()
	if _G.FlyEnabled then
		pcall(function()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			
			if not flyLinearVelocity or not flyAlignOrientation or not flyAttachment then
				startFlyPhysics()
			end

			local cam = workspace.CurrentCamera
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			local moveDir = humanoid and humanoid.MoveDirection or Vector3.new()

			local targetVel = Vector3.new()
			if moveDir.Magnitude > 0 then
				local camCF = cam.CFrame
				local camLook = camCF.LookVector
				local camRight = camCF.RightVector
				local flatLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
				local flatRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
				local lookDot = moveDir:Dot(camLook)
				local rightDot = moveDir:Dot(camRight)
				targetVel = (flatLook * lookDot + flatRight * rightDot + Vector3.new(0, camLook.Y * math.abs(lookDot), 0)).Unit * _G.FlySpeedValue
			else
				targetVel = Vector3.new(0, 0, 0)
			end

			if flyLinearVelocity then flyLinearVelocity.VectorVelocity = targetVel end
			if flyAlignOrientation then flyAlignOrientation.CFrame = cam.CFrame end
		end)
	else
		stopFlyPhysics()
	end
end)

