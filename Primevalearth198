local function updateHomePlaylist()
	for _, child in pairs(playlistScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			count = count + 1
			local pBtn = Instance.new("TextButton")
			pBtn.Parent = playlistScroll
			pBtn.Size = UDim2.new(1, -4, 0, 26)
			pBtn.BackgroundColor3 = (combatConfig.TargetPlayer == p) and Color3.fromRGB(255, 105, 180) or Color3.fromRGB(40, 40, 50)
			pBtn.BorderSizePixel = 0
			pBtn.Text = "  " .. (p.DisplayName or p.Name)
			pBtn.TextColor3 = Color3.fromRGB(240, 240, 245)
			pBtn.TextSize = 11
			pBtn.Font = Enum.Font.FredokaOne
			pBtn.TextXAlignment = Enum.TextXAlignment.Left
			
			local pbCorner = Instance.new("UICorner") pbCorner.CornerRadius = UDim.new(0, 4) pbCorner.Parent = pBtn
			
			pBtn.MouseButton1Click:Connect(function()
				combatConfig.TargetPlayer = p
				playlistLabel.Text = "Chọn Người Chơi: " .. (p.DisplayName or p.Name)
				isPlaylistVisible = false
				playlistScroll.Visible = false
				togglePlaylistBtn.Text = "Hiện Danh Sách Người Chơi ▼"
				updateHomePlaylist()
			end)
		end
	end
	playlistScroll.CanvasSize = UDim2.new(0, 0, 0, count * 30)
end

