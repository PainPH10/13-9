-- ==================== TELEPORT & COMBAT LOGIC (SUPER RIGID HITBOX) ====================
local lastTargetLookVector = {}
local currentAngle = 0

-- Biến điều khiển chuyển đổi 2 bên hông mỗi 1s
local currentSideMultiplier = 1
task.spawn(function()
	while true do
		task.wait(1)
		currentSideMultiplier = -currentSideMultiplier
	end
end)

local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Blacklist
overlapParams.RespectCanCollide = false

local function teleportToTarget(myHrp, targetHrp, targetPlayer, distOffset, heightOffset, mode)
	if not myHrp or not targetHrp then return end
	
	-- Cập nhật danh sách loại trừ chính bản thân người chơi cho Hitbox
	local myChar = player.Character
	if myChar then
		overlapParams.FilterDescendantsInstances = {myChar}
	end
	
	-- Tùy chọn xoay vòng tròn
	if combatConfig.CircleEnabled then
		currentAngle = currentAngle + (combatConfig.CircleSpeed * RunService.RenderStepped:Wait())
		local offset = Vector3.new(math.cos(currentAngle) * distOffset, heightOffset, math.sin(currentAngle) * distOffset)
		local orbitPosition = targetHrp.Position + offset
		
		myHrp.CFrame = CFrame.new(orbitPosition, Vector3.new(targetHrp.Position.X, orbitPosition.Y, targetHrp.Position.Z))
		myHrp.AssemblyLinearVelocity = Vector3.zero
		myHrp.AssemblyAngularVelocity = Vector3.zero
		return
	end

	local currentCFrame = targetHrp.CFrame
	local currentLook = currentCFrame.LookVector
	
	local targetKey = targetPlayer or targetHrp
	if not lastTargetLookVector[targetKey] then
		lastTargetLookVector[targetKey] = currentLook
	else
		lastTargetLookVector[targetKey] = lastTargetLookVector[targetKey]:Lerp(currentLook, 0.35).Unit
	end
	
	local lookVector = lastTargetLookVector[targetKey]
	
	if targetHrp.AssemblyLinearVelocity.Magnitude > 2 then
		local moveVel = Vector3.new(targetHrp.AssemblyLinearVelocity.X, 0, targetHrp.AssemblyLinearVelocity.Z)
		if moveVel.Magnitude > 1 then
			lookVector = moveVel.Unit
		end
	end
	
	local targetPosFlat = Vector3.new(targetHrp.Position.X, 0, targetHrp.Position.Z)
	local finalPosition = Vector3.zero

	if mode == "Tail" then
		-- Chức năng BÁM ĐUÔI
		local tailPosition = targetHrp.Position - (lookVector * distOffset) + Vector3.new(0, heightOffset, 0)
		targetPosFlat = Vector3.new(targetHrp.Position.X, tailPosition.Y, targetHrp.Position.Z)
		finalPosition = tailPosition
	else
		-- Chức năng BÁM 2 BÊN HÔNG (Mặc định)
		local rightVector = Vector3.new(-lookVector.Z, 0, lookVector.X).Unit
		local sidePosition = targetHrp.Position + (rightVector * (distOffset * currentSideMultiplier)) + Vector3.new(0, heightOffset, 0)
		targetPosFlat = Vector3.new(targetHrp.Position.X, sidePosition.Y, targetHrp.Position.Z)
		finalPosition = sidePosition
	end
	
	-- Dùng Raycast/Bounds kiểm tra vùng xung quanh để giữ bám dính chắc chắn, chống lướt qua
	local hitboxSize = Vector3.new(6, 6, 6)
	local regionCF = CFrame.new(finalPosition)
	local parts = workspace:GetPartBoundsInBox(regionCF, hitboxSize, overlapParams)
	
	for _, part in ipairs(parts) do
		local hitCharacter = part.Parent
		local humanoid = hitCharacter:FindFirstChildOfClass("Humanoid")
		if humanoid and hitCharacter ~= myChar then
			-- Đã bắt trúng mục tiêu trong vùng quét siêu dính
			break
		end
	end
	
	myHrp.CFrame = CFrame.new(finalPosition, targetPosFlat)
	myHrp.AssemblyLinearVelocity = Vector3.zero
	myHrp.AssemblyAngularVelocity = Vector3.zero
end

