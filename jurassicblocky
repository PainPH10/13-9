local function getTailPart(character)
    if not character then return nil end
    local possibleNames = {"Tail", "Tail1", "Tail2", "Tail3", "Tail10", "LowerTorso", "Pelvis", "HumanoidRootPart"}
    for _, name in ipairs(possibleNames) do
        local part = character:FindFirstChild(name, true)
        if part and part:IsA("BasePart") then
            return part
        end
    end
    return character:FindFirstChild("HumanoidRootPart")
end

-- ESP SYSTEM
local isEsp = false

local espContainer = playerGui:FindFirstChild("ESP_Container")
if not espContainer then
    espContainer = Instance.new("Folder")
    espContainer.Name = "ESP_Container"
    espContainer.Parent = playerGui
end

local function removeEspForPlayerName(pName)
    local oldGui = espContainer:FindFirstChild("ESP_Gui_" .. pName)
    if oldGui then oldGui:Destroy() end
    
    local oldHighlight = espContainer:FindFirstChild("ESP_Highlight_" .. pName)
    if oldHighlight then oldHighlight:Destroy() end
end

local function updateOrCreateEsp(p)
    if not isEsp or p == player then 
        removeEspForPlayerName(p.Name)
        return 
    end

    local char = p.Character
    if not char or not char.Parent then
        removeEspForPlayerName(p.Name)
        return
    end

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local targetPart = char:FindFirstChild("HumanoidRootPart") 
        or char.PrimaryPart 
        or char:FindFirstChild("Head") 
        or char:FindFirstChildWhichIsA("BasePart")

    if not humanoid or humanoid.Health <= 0 or not targetPart then
        removeEspForPlayerName(p.Name)
        return
    end

    local highlight = espContainer:FindFirstChild("ESP_Highlight_" .. p.Name)
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "ESP_Highlight_" .. p.Name
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.FillColor = Color3.fromRGB(0, 230, 255)
        highlight.OutlineColor = Color3.fromRGB(0, 255, 120)
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = espContainer
    end
    highlight.Adornee = char

    local billboard = espContainer:FindFirstChild("ESP_Gui_" .. p.Name)
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_Gui_" .. p.Name
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.new(0, 140, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 4, 0)
        billboard.MaxDistance = math.huge
        billboard.Parent = espContainer

        local nameLabel = Instance.new("TextLabel", billboard)
        nameLabel.Name = "NameLabel"
        nameLabel.Size = UDim2.new(1, 0, 0, 18)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = p.DisplayName
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.TextSize = 12
        nameLabel.Font = Enum.Font.GothamBold
        
        local nameStroke = Instance.new("UIStroke", nameLabel)
        nameStroke.Color = Color3.fromRGB(0, 0, 0)

        local healthBg = Instance.new("Frame", billboard)
        healthBg.Name = "HealthBg"
        healthBg.Size = UDim2.new(1, 0, 0, 6)
        healthBg.Position = UDim2.new(0, 0, 0, 20)
        healthBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        healthBg.BorderSizePixel = 0
        Instance.new("UICorner", healthBg).CornerRadius = UDim.new(0, 3)

        local healthBar = Instance.new("Frame", healthBg)
        healthBar.Name = "HealthBar"
        healthBar.Size = UDim2.new(1, 0, 1, 0)
        healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        healthBar.BorderSizePixel = 0
        Instance.new("UICorner", healthBar).CornerRadius = UDim.new(0, 3)

        local hpText = Instance.new("TextLabel", billboard)
        hpText.Name = "HpText"
        hpText.Size = UDim2.new(1, 0, 0, 14)
        hpText.Position = UDim2.new(0, 0, 0, 28)
        hpText.BackgroundTransparency = 1
        hpText.TextColor3 = Color3.fromRGB(220, 220, 220)
        hpText.TextSize = 10
        hpText.Font = Enum.Font.Gotham
        
        local hpStroke = Instance.new("UIStroke", hpText)
        hpStroke.Color = Color3.fromRGB(0, 0, 0)
    end

    billboard.Adornee = targetPart

    local maxHp = math.max(humanoid.MaxHealth, 1)
    local hpPct = math.clamp(humanoid.Health / maxHp, 0, 1)
    
    local healthBar = billboard.HealthBg.HealthBar
    healthBar.Size = UDim2.new(hpPct, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(255 * (1 - hpPct), 255 * hpPct, 0)

    local distStr = ""
    local myChar = player.Character
    if myChar and myChar:FindFirstChild("HumanoidRootPart") then
        local dist = math.floor((myChar.HumanoidRootPart.Position - targetPart.Position).Magnitude)
        distStr = " | " .. dist .. "m"
    end

    billboard.HpText.Text = math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth) .. distStr
end

