local function getTargetCharacter(hrp)
    if typeof(selectedPlayer) == "Instance" and selectedPlayer:IsA("Player") then
        if selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("Humanoid") and selectedPlayer.Character.Humanoid.Health > 0 then
            return selectedPlayer.Character
        end
    end

    local nearestChar = nil
    local shortestDistance = math.huge
    for _, p in ipairs(players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("Humanoid") then
            if p.Character.Humanoid.Health > 0 then
                local tailPart = getTailPart(p.Character)
                if tailPart then
                    local distance = (hrp.Position - tailPart.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        nearestChar = p.Character
                    end
                end
            end
        end
    end
    return nearestChar
end

local isFlying = false
local flyConnection = nil

flyBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    if isFlying then
        flyBtn.Text = "🚀 Bay & Bám Đuôi: BẬT"
        flyBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 90)

        flyConnection = runService.Heartbeat:Connect(function(dt)
            if not isFlying then return end
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
            
            local hrp = char.HumanoidRootPart
            local hum = char.Humanoid
            
            hum.PlatformStand = true
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            local targetChar = getTargetCharacter(hrp)
            if targetChar then
                local targetHrp = targetChar:FindFirstChild("HumanoidRootPart") or getTailPart(targetChar)
                if targetHrp then
                    local targetCF = targetHrp.CFrame
                    local _, targetYaw, _ = targetCF:ToOrientation()
                    
                    local goalPos = targetCF.Position - Vector3.new(0, math.max(currentHeight, 5), 0)
                    local dist = (goalPos - hrp.Position).Magnitude
                    
                    local newPos = hrp.Position
                    if dist > 0.1 then
                        local stepDist = math.min(dist, flySpeed * dt)
                        local dir = (goalPos - hrp.Position).Unit
                        newPos = hrp.Position + (dir * stepDist)
                    else
                        newPos = goalPos
                    end
                    
                    hrp.CFrame = CFrame.new(newPos) * CFrame.Angles(0, targetYaw, 0) * CFrame.Angles(math.rad(90), 0, 0)
                end
            end
        end)
    else
        flyBtn.Text = "🚀 Bay & Bám Đuôi: TẮT"
        flyBtn.BackgroundColor3 = Color3.fromRGB(180, 45, 60)
        
        if flyConnection then
            flyConnection:Disconnect()
            flyConnection = nil
        end
        
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
            local hrp = char.HumanoidRootPart
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end)
