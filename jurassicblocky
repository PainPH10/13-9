local function createAdjuster(titleText, initialVal, minVal, maxVal, step, parent, onValChange, order)
    local container = Instance.new("Frame", parent)
    container.Size = UDim2.new(1, -4, 0, 32)
    container.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
    container.LayoutOrder = order
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)
    
    local stroke = Instance.new("UIStroke", container)
    stroke.Color = Color3.fromRGB(40, 40, 55)

    local valLabel = Instance.new("TextLabel", container)
    valLabel.Size = UDim2.new(1, -65, 1, 0)
    valLabel.Position = UDim2.new(0, 8, 0, 0)
    valLabel.BackgroundTransparency = 1
    valLabel.TextColor3 = Color3.fromRGB(220, 220, 240)
    valLabel.Font = Enum.Font.Gotham
    valLabel.TextSize = 11
    valLabel.TextXAlignment = Enum.TextXAlignment.Left

    local currVal = initialVal
    local function update()
        valLabel.Text = titleText .. ": " .. tostring(currVal)
        onValChange(currVal)
    end

    local decBtn = Instance.new("TextButton", container)
    decBtn.Size = UDim2.new(0, 24, 0, 20)
    decBtn.Position = UDim2.new(1, -54, 0.5, -10)
    decBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 52)
    decBtn.TextColor3 = Color3.fromRGB(255, 90, 90)
    decBtn.Text = "−"
    decBtn.Font = Enum.Font.GothamBold
    decBtn.TextSize = 13
    Instance.new("UICorner", decBtn).CornerRadius = UDim.new(0, 4)

    local incBtn = Instance.new("TextButton", container)
    incBtn.Size = UDim2.new(0, 24, 0, 20)
    incBtn.Position = UDim2.new(1, -26, 0.5, -10)
    incBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 52)
    incBtn.TextColor3 = Color3.fromRGB(90, 255, 150)
    incBtn.Text = "+"
    incBtn.Font = Enum.Font.GothamBold
    incBtn.TextSize = 13
    Instance.new("UICorner", incBtn).CornerRadius = UDim.new(0, 4)

    decBtn.MouseButton1Click:Connect(function()
        currVal = math.clamp(currVal - step, minVal, maxVal)
        update()
    end)

    incBtn.MouseButton1Click:Connect(function()
        currVal = math.clamp(currVal + step, minVal, maxVal)
        update()
    end)

    update()
end

