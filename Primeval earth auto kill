local function createESP(plr)
	if plr == player then return end
	local function removeESP()
		if espFolder:FindFirstChild(plr.Name .. "_ESP") then espFolder[plr.Name .. "_ESP"]:Destroy() end
	end
	local function addESP()
		removeESP()
		local billboard = Instance.new("BillboardGui")
		billboard.Name = plr.Name .. "_ESP"
		billboard.Size = UDim2.new(0, 120, 0, 50)
		billboard.AlwaysOnTop = true
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		
		local nameTag = Instance.new("TextLabel")
		nameTag.Parent = billboard
		nameTag.Size = UDim2.new(1, 0, 0, 20)
		nameTag.BackgroundTransparency = 1
		nameTag.Text = plr.DisplayName or plr.Name
		nameTag.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameTag.TextStrokeTransparency = 0.5
		nameTag.Font = Enum.Font.GothamBold
		nameTag.TextSize = 13
		
		local healthBG = Instance.new("Frame")
		healthBG.Parent = billboard
		healthBG.Size = UDim2.new(0.8, 0, 0, 6)
		healthBG.Position = UDim2.new(0.1, 0, 0, 22)
		healthBG.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		healthBG.BorderSizePixel = 0
		local hbgc = Instance.new("UICorner") hbgc.CornerRadius = UDim.new(0, 3) hbgc.Parent = healthBG
		
		local healthBar = Instance.new("Frame")
		healthBar.Parent = healthBG
		healthBar.Size = UDim2.new(1, 0, 1, 0)
		healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
		healthBar.BorderSizePixel = 0
		local hbc = Instance.new("UICorner") hbc.CornerRadius = UDim.new(0, 3) hbc.Parent = healthBar
		
		billboard.Parent = espFolder
		
		task.spawn(function()
			while billboard.Parent and espEnabled do
				pcall(function()
					local char = plr.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if hrp and hum then
						billboard.Adornee = hrp
						local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
						healthBar.Size = UDim2.new(healthPercent, 0, 1, 0)
						billboard.Enabled = true
					else
						billboard.Enabled = false
					end
				end)
				task.wait(0.2)
			end
			billboard:Destroy()
		end)
	end
	plr.CharacterAdded:Connect(function() if espEnabled then addESP() end end)
	if plr.Character and espEnabled then addESP() end
end

