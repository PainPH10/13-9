	local myChar = player.Character
	local myHRP = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart)
	if not myHRP then return end

	if combatConfig.Enabled and combatConfig.TargetPlayer then
		local targetChar = combatConfig.TargetPlayer.Character
		local targetHRP = targetChar and (targetChar:FindFirstChild("HumanoidRootPart") or targetChar.PrimaryPart)
		if targetHRP then
			local waitPos = (targetHRP.CFrame * CFrame.new(0, 0, combatConfig.Distance)).Position
			myHRP.CFrame = CFrame.new(waitPos, targetHRP.Position)
			myHRP.Velocity = Vector3.new(0, 0, 0)
		end
	end

	if killConfig.Enabled then
		local nearestTargetHRP = nil
		local shortestDist = math.huge
		for _, p in ipairs(players:GetPlayers()) do
			if p ~= player and p.Character then
				local tHRP = p.Character:FindFirstChild("HumanoidRootPart")
				local tHum = p.Character:FindFirstChildOfClass("Humanoid")
				if tHRP and tHum and tHum.Health > 0 then
					local dist = (myHRP.Position - tHRP.Position).Magnitude
					if dist < shortestDist then
						shortestDist = dist
						nearestTargetHRP = tHRP
					end
				end
			end
		end

		if nearestTargetHRP then
			local waitPos = (nearestTargetHRP.CFrame * CFrame.new(0, 0, killConfig.Distance)).Position
			myHRP.CFrame = CFrame.new(waitPos, nearestTargetHRP.Position)
			myHRP.Velocity = Vector3.new(0, 0, 0)
		end
	end
end)

