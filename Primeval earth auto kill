local function updateHomePlaylist()
	for _, child in pairs(playlistScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	local count = 0
	for _, p in ipairs(players:GetPlayers()) do
		if p ~= player then
			count = count + 1
			local pBtn = Instance.new("TextButton")
			pBtn.Parent = playlistScroll
			pBtn.Size = UDim2.new(1, -4, 0, 28)
			pBtn.BackgroundColor3 = (combatConfig.TargetPlayer == p) and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(30, 30, 45)
			pBtn.Text = "  " .. (p.DisplayName or p.Name)
			pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			pBtn.TextSize = 12
			pBtn.Font = Enum.Font.GothamMedium
			pBtn.TextXAlignment = Enum.TextXAlignment.Left
			
			local pbCorner = Instance.new("UICorner") pbCorner.CornerRadius = UDim.new(0, 4) pbCorner.Parent = pBtn
			
			pBtn.MouseButton1Click:Connect(function()
				combatConfig.TargetPlayer = p
				playlistLabel.Text = "Chọn Mục Tiêu (Playlist): " .. (p.DisplayName or p.Name)
				updateHomePlaylist()
			end)
		end
	end
	playlistScroll.CanvasSize = UDim2.new(0, 0, 0, count * 32)
end

homeRefreshBtn.MouseButton1Click:Connect(updateHomePlaylist)
