local function updateDistanceSlider(val)
	local rounded = math.clamp(math.floor(val + 0.5), 5, 50)
	combatConfig.Distance = rounded
	killConfig.Distance = rounded
	distLabel.Text = "Độ Xa Sau Lưng: " .. tostring(rounded) .. " Studs"
	distSliderFill.Size = UDim2.new((rounded - 5) / (50 - 5), 0, 1, 0)
end

local draggingDist = false
distSliderBG.MouseButton1Down:Connect(function()
	draggingDist = true
	local mouse = player:GetMouse()
	local absPos = distSliderBG.AbsolutePosition.X
	local absSize = distSliderBG.AbsoluteSize.X
	if absSize > 0 then
		local pos = math.clamp((mouse.X - absPos) / absSize, 0, 1)
		updateDistanceSlider(5 + (pos * 45))
	end
end)

userInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingDist = false
	end
end)

userInputService.InputChanged:Connect(function(input)
	if draggingDist and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local absPos = distSliderBG.AbsolutePosition.X
		local absSize = distSliderBG.AbsoluteSize.X
		if absSize > 0 then
			local pos = math.clamp((input.Position.X - absPos) / absSize, 0, 1)
			updateDistanceSlider(5 + (pos * 45))
		end
	end
end)

