-- --- HOOK METAMETHOD ---
local GiveAllCreatures = ReplicatedStorage:WaitForChild("GiveAllCreatures")
local Eat = ReplicatedStorage:WaitForChild("Eat")

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if FastAttackEnabled and not checkcaller() then
        if method == "FireServer" then
            if self == GiveAllCreatures then
                return nil
            end
            if self == Eat and args[1] == "SpecialCheck0000" then
                return oldNamecall(self, unpack(args))
            end
        end
    end

    if flyEnabled and not checkcaller() and (method == "FireServer" or method == "InvokeServer") then
        local remoteName = string.lower(self.Name)
        if string.find(remoteName, "teleport") or string.find(remoteName, "cheat") or string.find(remoteName, "void") or string.find(remoteName, "position") or string.find(remoteName, "check") or string.find(remoteName, "reset") then
            return nil
        end
    end

    return oldNamecall(self, ...)
end))

local oldNewIndex
oldNewIndex = hookmetamethod(game, "__newindex", newcclosure(function(self, idx, val)
    if flyEnabled and not checkcaller() and localPlayer.Character then
        local hrp = localPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
        if (self == hrp and (idx == "CFrame" or idx == "Position" or idx == "Velocity" or idx == "AssemblyLinearVelocity")) or (self == hum and idx == "HipHeight") then
            return
        end
    end
    return oldNewIndex(self, idx, val)
end))

-- --- XỬ LÝ AUTO ATTACK ---
local function doAutoAttack()
    local playerGui = localPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in pairs(playerGui:GetDescendants()) do
            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                local btnText = (gui:IsA("TextButton") and gui.Text) or gui.Name
                if string.find(string.upper(btnText), "TẤN CÔNG") or string.find(string.upper(btnText), "TAN CONG") or gui.Name == "Attack" then
                    if firesignal then
                        firesignal(gui.MouseButton1Click)
                        firesignal(gui.Activated)
                    elseif getconnections then
                        for _, conn in pairs(getconnections(gui.MouseButton1Click)) do
                            conn:Fire()
                        end
                        for _, conn in pairs(getconnections(gui.Activated)) do
                            conn:Fire()
                        end
                    end
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        if AutoAttackEnabled then
            pcall(doAutoAttack)
        end
        task.wait(0.15)
    end
end)

-- --- XỬ LÝ FAST ATTACK CD ---
task.spawn(function()
    while true do
        local character = localPlayer and localPlayer.Character
        if character and character:FindFirstChild("CreatureInfo") then
            local cd = character.CreatureInfo:FindFirstChild("AttackCooldown")
            local aoeCd = character.CreatureInfo:FindFirstChild("AOEAttackCooldown")

            if FastAttackEnabled then
                if cd and not cd:GetAttribute("OriginalCD") then
                    cd:SetAttribute("OriginalCD", cd.Value)
                end
                if aoeCd and not aoeCd:GetAttribute("OriginalCD") then
                    aoeCd:SetAttribute("OriginalCD", aoeCd.Value)
                end

                if cd then cd.Value = 0.1 end
                if aoeCd then aoeCd.Value = 0.1 end
            else
                if cd and cd:GetAttribute("OriginalCD") then
                    cd.Value = cd:GetAttribute("OriginalCD")
                    cd:SetAttribute("OriginalCD", nil)
                end
                if aoeCd and aoeCd:GetAttribute("OriginalCD") then
                    aoeCd.Value = aoeCd:GetAttribute("OriginalCD")
                    aoeCd:SetAttribute("OriginalCD", nil)
                end
            end
        end
        task.wait(0.1)
    end
end)

