local espFolder = Instance.new("Folder")
espFolder.Name = "ESPFolder"
espFolder.Parent = ScreenGui

local function removeEsp(otherPlayer)
	if espFolder:FindFirstChild(otherPlayer.Name .. "_ESP") then
		espFolder[otherPlayer.Name .. "_ESP"]:Destroy()
	end
end

local function addEsp(otherPlayer)
	if otherPlayer == LocalPlayer then return end
	local billboard = Instance.new("BillboardGui")
	billboard.Name = otherPlayer.Name .. "_ESP"
	billboard.Size = UDim2.new(0, 120, 0, 45)
	billboard.AlwaysOnTop = true
	
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
	nameLabel.TextStrokeTransparency = 0.4
	nameLabel.TextSize = 12
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.Parent = billboard
	
	local healthLabel = Instance.new("TextLabel")
	healthLabel.Name = "HealthLabel"
	healthLabel.Size = UDim2.new(1, 0, 0.5, 0)
	healthLabel.Position = UDim2.new(0, 0, 0.5, 0)
	healthLabel.BackgroundTransparency = 1
	healthLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
	healthLabel.TextStrokeTransparency = 0.4
	healthLabel.TextSize = 12
	healthLabel.Font = Enum.Font.GothamBold
	healthLabel.Parent = billboard
	
	billboard.Parent = espFolder
	
	RunService.RenderStepped:Connect(function()
		if not espEnabled then
			billboard.Enabled = false
			return
		end
		local c = otherPlayer.Character
		if c and c:FindFirstChild("Head") and c:FindFirstChild("Humanoid") then
			billboard.Adornee = c.Head
			billboard.Enabled = true
			local humanoid = c.Humanoid
			nameLabel.Text = otherPlayer.DisplayName
			healthLabel.Text = math.floor(humanoid.Health) .."/" .. math.floor(humanoid.MaxHealth)
		else
			billboard.Enabled = false
		end
	end)
end

