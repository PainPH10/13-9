local function getHRP_AutoFarm()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
end

task.spawn(function()
    local visitedOrbs = {}
    local burstCount = 0

    while task.wait(0.15) do
        if autoFarm and LocalPlayer.Character then
            local char = LocalPlayer.Character
            local hrp = getHRP_AutoFarm()
            local humanoid = char:FindFirstChildOfClass("Humanoid")

            if hrp and humanoid then
                if burstCount >= 2 then
                    burstCount = 0
                    visitedOrbs = {} 
                    task.wait(1.5) 
                end

                local bestFood = nil
                local shortestDist = math.huge

                for _, food in pairs(workspace:GetDescendants()) do
                    if food and food.Parent and not visitedOrbs[food] then
                        local nameLower = string.lower(food.Name)
                        if string.find(nameLower, "food") or string.find(nameLower, "orb") or string.find(nameLower, "meat") or string.find(nameLower, "hp") then
                            local pos = nil
                            local isVisible = true
                            pcall(function()
                                if food:IsA("Model") then
                                    pos = food:GetPivot().Position
                                elseif food:IsA("BasePart") then
                                    pos = food.Position
                                    if food.Transparency >= 1 then isVisible = false end
                                end
                            end)

                            if pos and isVisible then
                                local dist = (hrp.Position - pos).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    bestFood = food
                                end
                            end
                        end
                    end
                end

                if bestFood then
                    visitedOrbs[bestFood] = true

                    local targetCFrame = nil
                    pcall(function()
                        if bestFood:IsA("Model") then
                            targetCFrame = bestFood:GetPivot()
                        elseif bestFood:IsA("BasePart") then
                            targetCFrame = bestFood.CFrame
                        end
                    end)

                    if targetCFrame then
                        pcall(function()
                            humanoid.PlatformStand = true
                        end)

                        local distance = (hrp.Position - targetCFrame.Position).Magnitude
                        local travelTime = math.clamp(distance / 220, 0.03, 0.25)

                        local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Linear)
                        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
                        
                        tween:Play()
                        task.wait(travelTime)

                        pcall(function()
                            if bestFood:IsA("BasePart") then
                                firetouchinterest(hrp, bestFood, 0)
                                firetouchinterest(hrp, bestFood, 1)
                            elseif bestFood:IsA("Model") and bestFood.PrimaryPart then
                                firetouchinterest(hrp, bestFood.PrimaryPart, 0)
                                firetouchinterest(hrp, bestFood.PrimaryPart, 1)
                            end
                        end)

                        burstCount = burstCount + 1
                        task.wait(0.2)
                        
                        pcall(function()
                            humanoid.PlatformStand = false
                        end)
                    else
                        task.wait(0.1)
                    end
                else
                    visitedOrbs = {}
                    burstCount = 0
                    task.wait(0.5)
                end
            end
        end
    end
end)

-- ==================== XỬ LÝ LOGIC FLY ====================
local char, hrp, hum
local att, lv, ag
local flySpeed = 50

local function updateChar()
    char = LocalPlayer.Character
    if char then
        hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChildOfClass("BasePart")
        hum = char:FindFirstChildOfClass("Humanoid")
    end
end

LocalPlayer.CharacterAdded:Connect(function(c)
    task.wait(1)
    updateChar()
end)
updateChar()

local function startFly()
    updateChar()
    if not hrp then return end
    flyEnabled = true
    
    att = Instance.new("Attachment", hrp)
    
    lv = Instance.new("LinearVelocity")
    lv.Attachment0 = att
    lv.MaxForce = math.huge
    lv.VectorVelocity = Vector3.new(0, 0, 0)
    lv.Parent = hrp
    
    ag = Instance.new("AlignOrientation")
    ag.Attachment0 = att
    ag.MaxTorque = math.huge
    ag.Responsiveness = 200
    ag.Parent = hrp
    
    flyButton.Text = "Fly: [ BẬT ]"
    TweenService:Create(flyButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(110, 15, 15), BackgroundTransparency = 0.2}):Play()
    TweenService:Create(fBtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(255, 60, 60), Transparency = 0}):Play()
end

local function stopFly()
    flyEnabled = false
    if lv then lv:Destroy() end
    if ag then ag:Destroy() end
    if att then att:Destroy() end
    flyButton.Text = "Fly: [ TẮT ]"
    TweenService:Create(flyButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 25), BackgroundTransparency = 0.4}):Play()
    TweenService:Create(fBtnStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(50, 50, 50), Transparency = 0.3}):Play()
end

flyButton.MouseButton1Click:Connect(function()
    if flyEnabled then stopFly() else startFly() end
end)

RunService.RenderStepped:Connect(function()
    if not flyEnabled or not hrp or not lv or not ag then return end
    local cam = workspace.CurrentCamera
    
    local moveDir = Vector3.new()
    if hum then moveDir = hum.MoveDirection end
    
    local targetVel = Vector3.new()
    if moveDir.Magnitude > 0 then
        local camCF = cam.CFrame
        local camLook = camCF.LookVector
        local camRight = camCF.RightVector
        local flatLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
        local flatRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
        local lookDot = moveDir:Dot(camLook)
        local rightDot = moveDir:Dot(camRight)
        targetVel = (flatLook * lookDot + flatRight * rightDot + Vector3.new(0, camLook.Y * math.abs(lookDot), 0)).Unit * flySpeed
    else
        targetVel = Vector3.new(0, 0, 0)
    end
    lv.VectorVelocity = targetVel
    ag.CFrame = cam.CFrame
end)

